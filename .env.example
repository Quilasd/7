# Токен бота от @BotFather
BOT_TOKEN=123456789:AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQq

# Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# База данных:
#   SQLite (разработка):      sqlite+aiosqlite:///./data/mafia.db
#   PostgreSQL (продакшен):   postgresql+asyncpg://mafia:mafia@localhost:5432/mafia
DATABASE_URL=sqlite+aiosqlite:///./data/mafia.db

# Создавать таблицы автоматически при старте (для dev; в prod используйте alembic)
AUTO_CREATE_TABLES=true

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# DEBUG MODE: включает /testgame (тестовые игры с ботами).
# Доступно глобальному Owner (OWNER_IDS) и уровням с правом USE_DEBUG
# (Admin+ в группе при включённой настройке группы debug_enabled).
# На продакшене держите false.
DEBUG_MODE=false

# Глобальный Owner проекта — полный доступ везде, включая DEBUG MODE.
# Только эти ID имеют уровень Owner (назначается через .env, не через бота).
OWNER_IDS=123456789

# Меняет ли DEBUG MODE настоящую статистику тестовых игр:
#   false — статистика/рейтинг/XP НЕ трогаются (по умолчанию);
#   true  — изменения идут в реальную глобальную/локальную статистику.
DEBUG_AFFECTS_GLOBAL_STATS=false
DEBUG_AFFECTS_LOCAL_STATS=false

# Игровые дефолты (переопределяются настройками комнаты и админкой)
DEFAULT_NIGHT_SECONDS=90
DEFAULT_DAY_SECONDS=180
DEFAULT_VOTE_SECONDS=60
START_COUNTDOWN_SECONDS=5
MIN_PLAYERS_LIMIT=4
MAX_PLAYERS_LIMIT=20
